aws_region  = "us-east-1"
environment = "dev"
# Copie do output cluster_name do repositório oficina-mecanica-infra-kubernetes
# (ou deixe vazio para usar <project_name>-<environment>, igual ao default daquele repositório).
cluster_name = ""
# Copie do output oidc_provider_arn do repositório oficina-mecanica-infra-kubernetes
# após aplicar aquele Terraform.
eks_oidc_provider_arn = ""
# Copie do output rds_password do repositório oficina-mecanica-infra-banco-dados.
postgres_password = ""
# Troque estes valores em ambientes reais.
jwt_secret_key = "change-me-in-production"
admin_password = "Admin@123"
smtp_password  = ""

tags = {
  Owner      = "seu-usuario"
  CostCenter = "fiap"
}
