aws_region  = "us-east-1"
environment = "dev"
# Bucket/região do backend S3 compartilhado (infra/backend) e keys de state dos
# repositórios oficina-mecanica-infra-kubernetes e oficina-mecanica-infra-banco-dados.
# Os defaults abaixo já cobrem o ambiente "dev"; ajuste só se usar outro ambiente
# ou um bucket com nome diferente.
tf_state_bucket       = "oficina-mecanica-fiap-terraform-state"
tf_state_region       = "us-east-1"
kubernetes_state_key  = "kubernetes/dev/terraform.tfstate"
database_state_key    = "database/dev/terraform.tfstate"
# Troque estes valores em ambientes reais.
jwt_secret_key = "change-me-in-production"
admin_password = "Admin@123"
smtp_password  = ""

tags = {
  Owner      = "seu-usuario"
  CostCenter = "fiap"
}
